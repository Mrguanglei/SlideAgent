# ==================== PPTAgent 环境变量配置 ====================
# 复制此文件为 .env 并填入你的实际 API 密钥

# ==================== 核心 LLM 配置（必需）====================
# 用于意图识别、任务规划、大纲生成、PPT内容编写、PPT设计

# 豆包/火山引擎 API 配置（推荐）
PPTAGENT_MODEL=doubao-seed-1-8-251228
PPTAGENT_API_KEY=your_api_key_here
PPTAGENT_API_BASE=https://ark.cn-beijing.volces.com/api/v3

# 或者使用智谱AI（GLM-4）
# PPTAGENT_MODEL=glm-4-plus
# PPTAGENT_API_KEY=your_glm_api_key
# PPTAGENT_API_BASE=https://open.bigmodel.cn/api/paas/v4/

# ==================== 网络搜索配置（必需）====================
# Tavily API - 用于网络搜索获取PPT参考资料
# 申请地址: https://www.tavily.com/
#下面相同key，后续会去掉
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_BACKUP=your_backup_tavily_key_here

# ==================== 数据库配置 ====================
# PostgreSQL 数据库连接（Docker Compose 会自动配置）

DATABASE_URL=postgresql://pptagent:pptagent_password@postgres:5432/pptagent

# ==================== 工作空间配置 ====================
# PPT 生成临时文件存储路径

WORKSPACE_BASE=/tmp/ppt_workspace

# ==================== 可选配置 ====================

# 知识库 LLM 配置（如果使用知识库功能）
KNOWLEDGE_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
KNOWLEDGE_LLM_API_KEY=your_knowledge_llm_key
KNOWLEDGE_LLM_MODEL=glm-4.6
KNOWLEDGE_EMBEDDING_MODEL=embedding-3

# MinerU API（如果需要PDF解析功能）
# 申请地址: https://mineru.net/apiManage/docs
# 注意：每个密钥有效期14天
MINERU_API_KEY=your_mineru_api_key_here

# ==================== DeepPresenter 高级配置（可选）====================
# 注意：如果不配置以下选项，系统会自动使用上面的核心 LLM 配置

# Design Agent - 用于PPT设计（支持多模态）
# 如果不配置，会使用 PPTAGENT_* 配置
DESIGN_AGENT_MODEL=doubao-seed-1-8-251228
DESIGN_AGENT_API_KEY=your_api_key
DESIGN_AGENT_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DESIGN_AGENT_MULTIMODAL=true

# ==================== 使用说明 ====================
#
# 最小配置（仅需这3项即可运行）：
#   1. PPTAGENT_API_KEY + PPTAGENT_API_BASE + PPTAGENT_MODEL
#   2. TAVILY_API_KEY
#   3. DATABASE_URL（Docker Compose自动配置）
#
# 推荐模型：
#   - 豆包 Seed 1.8: 性能强大，性价比高
#   - GLM-4-Plus: 中文理解优秀
#   - Claude Sonnet: 推理能力强（需要海外API）
#
# 核心业务流程：
#   1. 用户输入 → 意图识别（使用 PPTAGENT_MODEL）
#   2. 任务规划（使用 PPTAGENT_MODEL）
#   3. 网络搜索（使用 TAVILY_API_KEY）
#   4. 生成PPT大纲（使用 PPTAGENT_MODEL）
#   5. PPT设计和内容编写（使用 DESIGN_AGENT 或 PPTAGENT_MODEL）
#   6. 导出PPTX文件
#
# 注意事项：
#   - 所有 API 密钥请妥善保管，不要提交到 Git
#   - 如果使用相同的 API 服务，可以只配置 PPTAGENT_* 即可
#   - DESIGN_AGENT 配置是可选的，不配置会自动使用 PPTAGENT 配置
#   - 未使用的功能（图像生成、图片识别等）已从配置中移除
#
