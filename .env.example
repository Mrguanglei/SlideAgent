# ==================== PPTAgent 环境变量配置 ====================
# 复制此文件为 .env 并填入你的实际 API 密钥

# ==================== 核心 LLM 配置（必需）====================
# 用于意图识别、任务规划、大纲生成、PPT内容编写、PPT设计
# 统一入口：会驱动 DesignAgent / Knowledge LLM
# 图像参考模型可单独配置为多模态模型（IMAGE_REFERENCE_MODEL）

# 统一核心模型（示例：gemini-3-flash）
PPTAGENT_MODEL=gemini-3-flash
PPTAGENT_API_KEY=your_api_key_here
# OpenAI-Compatible API Base（按你的网关地址填写）
PPTAGENT_API_BASE=http://your-openai-compatible-endpoint/v1
CONTEXT_LENGTH_LIMIT=96000

# ==================== 网络搜索配置（必需）====================
# Tavily API - 用于网络搜索获取PPT参考资料
# 申请地址: https://www.tavily.com/
#如果需要打开联网需要填写key
TAVILY_API_KEY=your_tavily_api_key_here
# MinerU API Key - 用于 PDF 智能解析（可选）
MINERU_API_KEY=your_mineru_api_key_here
# 图片搜索最多返回数量（默认 10）
IMAGE_SEARCH_MAX=10
# 图像参考策略模型（建议配置为多模态模型）
IMAGE_REFERENCE_MODEL=gemini-3-flash
# 图像参考策略接口默认复用 PPTAGENT_*（一般不需要额外配置）
# IMAGE_REFERENCE_MAX_IMAGES=12
# IMAGE_REFERENCE_CONCURRENCY=3
# IMAGE_REFERENCE_TIMEOUT_SECONDS=35
# IMAGE_REFERENCE_RETRIES=1
# 视觉评审与自动重排（PPTAgent 风格后评估闭环）
# VISUAL_REVIEW_ENABLED=true
# VISUAL_REVIEW_MIN_SCORE=78
# VISUAL_REVIEW_MAX_ROUNDS=1
# VISUAL_REVIEW_TIMEOUT_SECONDS=30
# VISUAL_REWRITE_TIMEOUT_SECONDS=40
# 跨页风格一致性复评（PPTAgent 风格“视觉总监”回路）
# DECK_STYLE_REVIEW_ENABLED=true
# DECK_STYLE_START_PAGE=2
# DECK_STYLE_MIN_SCORE=75
# DECK_STYLE_MAX_ROUNDS=1
# DECK_STYLE_REVIEW_TIMEOUT_SECONDS=28
# DECK_STYLE_REWRITE_TIMEOUT_SECONDS=35

# ==================== 数据库配置 ====================
# PostgreSQL 数据库连接（Docker Compose 会自动配置）

DATABASE_URL=postgresql+asyncpg://pptagent:pptagent_secret_2024@db:5432/pptagent_dev

# ==================== 工作空间配置 ====================
# PPT 生成临时文件存储路径

WORKSPACE_BASE=/tmp/ppt_workspace

# ==================== Web 安全配置 ====================
# 逗号分隔多个来源；生产环境请仅配置可信域名
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 注意：不要与 CORS_ALLOWED_ORIGINS=* 同时开启
CORS_ALLOW_CREDENTIALS=false

# ==================== 可选配置 ====================

# 知识库 LLM 配置（自动复用 PPTAGENT_*）
KNOWLEDGE_EMBEDDING_MODEL=embedding-3


# ==================== 使用说明 ====================
#
# 最小配置（仅需这3项即可运行）：
#   1. PPTAGENT_API_KEY + PPTAGENT_API_BASE + PPTAGENT_MODEL
#   2. TAVILY_API_KEY
#   3. DATABASE_URL（Docker Compose自动配置）
#
# 推荐模型：
#   - 豆包 Seed 1.8: 性能强大，性价比高
#   - GLM-4.7: 中文理解优秀
#   - Claude Sonnet: 推理能力强（需要海外API）
#
# 核心业务流程：
#   1. 用户输入 → 意图识别（使用 PPTAGENT_MODEL）
#   2. 任务规划（使用 PPTAGENT_MODEL）
#   3. 网络搜索（使用 TAVILY_API_KEY）
#   4. 生成PPT大纲（使用 PPTAGENT_MODEL）
#   5. PPT设计和内容编写（使用 DESIGN_AGENT 或 PPTAGENT_MODEL）
#   6. 导出PPTX文件
#
# 注意事项：
#   - 所有 API 密钥请妥善保管，不要提交到 Git
#   - 如果使用相同的 API 服务，可以只配置 PPTAGENT_* 即可
#   - 设计/知识库模型默认复用 PPTAGENT_*；图像参考模型可单独用 IMAGE_REFERENCE_MODEL
#
