# PPTAgent Environment Variables Configuration
# Copy this file to .env and fill in your actual API keys

# ==================== Required External Services ====================

# MinerU API Key (for PDF parsing) - https://mineru.net/apiManage/docs
# Note: Each key is valid for 14 days
MINERU_API_KEY=your_mineru_api_key_here

# Tavily API Keys (for web search) - https://www.tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_BACKUP=your_backup_tavily_key_here

# ==================== PPTAgent LLM Configuration ====================
# For template-based generation

PPTAGENT_MODEL=glm-4.6
PPTAGENT_API_KEY=your_pptagent_llm_api_key
PPTAGENT_API_BASE=https://open.bigmodel.cn/api/paas/v4/

#知识库
KNOWLEDGE_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
KNOWLEDGE_LLM_API_KEY=811b94b3
KNOWLEDGE_LLM_MODEL=glm-4.6
KNOWLEDGE_EMBEDDING_MODEL=embedding-3


# ==================== Workspace Configuration ====================

WORKSPACE_BASE=/cache/deeppresenter

# ==================== Additional Notes ====================
#
# For Research Agent and Design Agent LLM configuration,
# edit the config.yaml file directly:
#   deeppresenter/deeppresenter/config.yaml
#
# Recommended models:
#   - Research Agent: Claude Sonnet / Doubao Seed 1.8
#   - Design Agent: Gemini / GLM-4.7
#   - Vision Model: GLM-4.6 / Qwen2.5-VL
#   - T2I Model: CogView-3-Plus / Doubao SeeDream
#
# For MCP server configuration, edit:
#   deeppresenter/deeppresenter/mcp.json
