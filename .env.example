# ==================== SlideAgent 环境变量配置 ====================
# 复制此文件为 .env 并填入你的实际 API 密钥

# ==================== 核心 LLM 配置（必需）====================
# 用于意图识别、任务规划、大纲生成、PPT内容编写、PPT设计

# GLM系列 API 配置（推荐）
PPTAGENT_MODEL=glm-4.7
PPTAGENT_API_KEY=your_api_key_here
PPTAGENT_API_BASE=https://open.bigmodel.cn/api/paas/v4
CONTEXT_LENGTH_LIMIT=96000

# ==================== 网络搜索配置（必需）====================
# Tavily API - 用于网络搜索获取PPT参考资料
# 申请地址: https://www.tavily.com/
#如果需要打开联网需要填写key
TAVILY_API_KEY=your_tavily_api_key_here


# ==================== 数据库配置 ====================
# PostgreSQL 数据库连接（Docker Compose 会自动配置）

DATABASE_URL=postgresql+asyncpg://pptagent:pptagent_secret_2024@db:5432/pptagent_dev

# ==================== 工作空间配置 ====================
# PPT 生成临时文件存储路径

WORKSPACE_BASE=/tmp/ppt_workspace

# ==================== 可选配置 ====================

# 知识库 LLM 配置（如果使用知识库功能）
KNOWLEDGE_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
KNOWLEDGE_LLM_API_KEY=your_knowledge_llm_key
KNOWLEDGE_LLM_MODEL=glm-4-plus

#向量模型配置（如果使用知识库功能）
KNOWLEDGE_EMBEDDING_MODEL=embedding-3


# ==================== 使用说明 ====================
#
# 最小配置（仅需这3项即可运行）：
#   1. PPTAGENT_API_KEY + PPTAGENT_API_BASE + PPTAGENT_MODEL
#   2. TAVILY_API_KEY
#   3. DATABASE_URL（Docker Compose自动配置）
#
# 推荐模型：
#   - GLM-5: 中文理解优秀
#   - 豆包 Seed 1.8: 性能强大，性价比高
#   - GLM-4.7: 中文理解优秀
#   - Claude Sonnet: 推理能力强（需要海外API）
#
# 核心业务流程：
#   1. 用户输入 → 意图识别（使用 PPTAGENT_MODEL）
#   2. 任务规划（使用 PPTAGENT_MODEL）
#   3. 网络搜索（使用 TAVILY_API_KEY）
#   4. 生成PPT大纲（使用 PPTAGENT_MODEL）
#   5. PPT设计和内容编写 PPTAGENT_MODEL）
#   6. 导出PPTX文件
#
# 注意事项：
#   - 所有 API 密钥请妥善保管，不要提交到 Git
#   - 如果使用相同的 API 服务，可以只配置 PPTAGENT_* 即可
#   - DESIGN_AGENT 配置是可选的，不配置会自动使用 PPTAGENT 配置
#   - 未使用的功能（图像生成、图片识别等）已从配置中移除
#
